[Unit]
Description=Agent Room GitHub control webhook receiver
Documentation=file:///opt/agent-room/current/docs/AGENT_ROOM_WEBHOOK.md
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=agentroom
Group=agentroom
UMask=0077
WorkingDirectory=/opt/agent-room/current
ExecStart=/usr/bin/python3 -m agent_room.webhook_receiver
Environment=PYTHONPATH=/opt/agent-room/current
Environment=PYTHONDONTWRITEBYTECODE=1
Environment=PYTHONNOUSERSITE=1
Environment=GIT_TERMINAL_PROMPT=0
Environment=HOME=/var/lib/agent-room/home
UnsetEnvironment=SSH_AUTH_SOCK SSH_AGENT_PID GIT_ASKPASS SSH_ASKPASS

Restart=on-failure
RestartSec=2
KillMode=control-group
KillSignal=SIGTERM
SendSIGKILL=yes
TimeoutStopSec=30

NoNewPrivileges=yes
CapabilityBoundingSet=
AmbientCapabilities=
RestrictSUIDSGID=yes
LockPersonality=yes
RestrictRealtime=yes
RestrictNamespaces=yes
SystemCallArchitectures=native
SystemCallFilter=@system-service
SystemCallFilter=~@privileged
SystemCallFilter=~@resources
SystemCallErrorNumber=EPERM
MemoryDenyWriteExecute=yes

ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
PrivateDevices=yes
PrivateMounts=yes
StateDirectory=agent-room
StateDirectoryMode=0700
ReadOnlyPaths=/opt/agent-room /etc/agent-room
InaccessiblePaths=/home/pr0
InaccessiblePaths=/var/lib/agent-room-claude /var/lib/agent-room-codex /var/lib/agent-room-coordinator /var/lib/agent-room-release
InaccessiblePaths=-/run/dbus/system_bus_socket -/run/systemd/private

ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
ProtectClock=yes
ProtectHostname=yes
ProtectProc=invisible
ProcSubset=pid
RemoveIPC=yes
KeyringMode=private

RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
PrivateNetwork=no
MemoryMax=384M
TasksMax=64
LimitNOFILE=1024

[Install]
WantedBy=multi-user.target
